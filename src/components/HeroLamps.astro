---
// Hand-sketched wool lamps standing in a U around the pull cord. Each lamp is its own pair of images, unlit and
// lit: on load they rise (pendants drop) and fade in one after another, and in dark mode (when the cord is pulled) the lit image
// flickers on over the unlit one. Only opacity and transform animate, so it all stays on the compositor.
// Phones and tablets get a tight U; desktops a row spanning the page.
// Regenerate the lamps with: node scripts/hero-lamps.mjs
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import layout from "./hero-lamps.json";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/lamps/*.svg", { eager: true });
const image = (name: string) => files[`../assets/lamps/${name}.svg`].default;
// The floor line sits 24 units above the bottom of each 470-unit-tall drawing; shifting the drawing down by that much
// (5.106%), less a few pixels, puts the floor just above the bottom edge of the hero, where the works' background begins.
// The glow below the floor hangs over that edge.
const sets = [
  { drawing: layout.phone, class: "lamps-phone max-w-md" },
  { drawing: layout.desktop, class: "lamps-wide" },
];
---

<div class="pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true">
  {
    sets.map(({ drawing, class: cls }) => (
      <div class:list={["lamps relative mx-auto w-full translate-y-[calc(5.106%-0.25rem)]", cls]} style={`aspect-ratio:${drawing.width}/${drawing.height}`}>
        {drawing.lamps.map((lamp) => {
          const off = image(lamp.name);
          const on = image(`${lamp.name}-on`);
          return (
            <div class:list={["lamp absolute", lamp.drop && "lamp-drop"]} style={`left:${lamp.left}%;top:${lamp.top}%;width:${lamp.width}%;--i:${lamp.order}`}>
              <Image src={off} alt="" width={off.width} height={off.height} loading="lazy" decoding="async" class="block h-auto w-full" />
              <Image src={on} alt="" width={on.width} height={on.height} loading="lazy" decoding="async" class="lit absolute inset-0 h-auto w-full" />
            </div>
          );
        })}
      </div>
    ))
  }
</div>

<style is:global>
  /* Lazy images in the hidden set are never fetched, so phones don't download the desktop lamps. */
  .lamps-wide {
    display: none;
  }
  @media (min-width: 64rem) {
    .lamps-phone {
      display: none;
    }
    .lamps-wide {
      display: block;
      /* Very wide screens: stop growing before the lamps reach the sheep. */
      max-width: calc((100svh - 16rem) * 1200 / 470);
    }
  }

  /* Each lamp rises a little from below as it fades in, then settles. */
  .lamps .lamp {
    animation: lamp-rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 0.38s + 0.2s);
  }
  /* Pendants (and their cords) come down from above instead. */
  .lamps .lamp-drop {
    animation-name: lamp-drop;
  }
  @keyframes lamp-drop {
    from {
      transform: translateY(-2.5rem);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
  }
  @keyframes lamp-rise {
    from {
      transform: translateY(2.5rem);
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
  }

  /* Off: the lit image is hidden. On: it flickers up over the unlit lamp, each lamp at its own moment. */
  .lamps .lit {
    opacity: 0;
    transition: opacity 0.35s ease-out;
  }
  .dark .lamps .lit {
    opacity: 1;
    animation: lamp-on 0.9s ease-out both;
    animation-delay: calc(var(--i) * 0.12s);
  }
  @keyframes lamp-on {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 0.75;
    }
    26% {
      opacity: 0.2;
    }
    40% {
      opacity: 0.9;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lamps .lamp,
    .dark .lamps .lit {
      animation: none;
    }
  }
</style>