---
// Hand-sketched wool lamps standing in a U around the pull cord. They draw themselves in on load and light up
// in dark mode (when the cord is pulled). Regenerate the drawing with: node scripts/hero-lamps.mjs
import lamps from "./hero-lamps.svg?raw";
---

<div class="pointer-events-none absolute inset-x-0 bottom-[4.75rem] mx-auto w-full max-w-md">
  <Fragment set:html={lamps} />
</div>

<style is:global>
  .lamps {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .lamps .bg {
    fill: var(--color-wool-50);
  }
  .dark .lamps .bg {
    fill: var(--color-wool-950);
  }
  .lamps .ln {
    stroke: var(--color-wool-700);
    stroke-width: 1.35;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .lamps .ln2 {
    stroke-width: 0.8;
    opacity: 0.55;
  }
  .lamps .wisp {
    stroke-width: 0.9;
    opacity: 0.45;
  }
  .lamps .floor {
    opacity: 0.35;
  }

  /* Each lamp rises from below while its pencil lines draw, then settles. */
  .lamps .lamp {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: lamp-rise 1.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 0.38s + 0.15s);
  }
  .lamps .lamp .ln {
    animation: lamp-draw 1.5s cubic-bezier(0.55, 0, 0.25, 1) forwards;
    animation-delay: calc(var(--i) * 0.38s + 0.2s);
  }
  .lamps .lamp .ln2 {
    animation-duration: 1.1s;
    animation-delay: calc(var(--i) * 0.38s + 0.75s);
  }
  .lamps .lamp .wisp {
    animation-duration: 0.9s;
    animation-delay: calc(var(--i) * 0.38s + 1.05s);
  }
  @keyframes lamp-rise {
    from {
      transform: translateY(70px);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
  }
  @keyframes lamp-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Off: no warm layer. */
  .lamps .warm {
    opacity: 0;
  }
  .lamps .hatch {
    stroke: #e58f3c;
    stroke-width: 1.5;
    opacity: 0.5;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .lamps .hatch2 {
    stroke: #fff1cf;
    stroke-width: 1.1;
    opacity: 0.6;
  }
  .lamps .ray {
    stroke: #f2b25e;
    stroke-width: 1.4;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  /* On: the glow flickers up, then warmth is scribbled over each lamp and little rays are drawn. */
  .dark .lamps .ln {
    stroke: var(--color-bark-800);
  }
  .dark .lamps .sup,
  .dark .lamps .floor {
    stroke: var(--color-bark-300);
  }
  .dark .lamps .floor {
    opacity: 0.25;
  }
  .dark .lamps .warm {
    opacity: 1;
    animation: lamp-on 0.9s ease-out both;
    animation-delay: calc(var(--i) * 0.12s);
  }
  .dark .lamps .hatch {
    animation: lamp-draw 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.12s + 0.25s);
  }
  .dark .lamps .ray {
    animation: lamp-draw 0.45s ease-out forwards;
    animation-delay: calc(var(--i) * 0.12s + 0.9s);
  }
  @keyframes lamp-on {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 0.75;
    }
    26% {
      opacity: 0.2;
    }
    40% {
      opacity: 0.9;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lamps .lamp,
    .lamps .ln,
    .dark .lamps .warm,
    .dark .lamps .hatch,
    .dark .lamps .ray {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
