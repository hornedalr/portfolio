---
import { profile } from "../data/site";

const links = [
  { href: "#work", label: "Work", desktopOnly: true },
  { href: "#about", label: "About", desktopOnly: true },
  { href: "#contact", label: "Contact", desktopOnly: false },
];
---

<header
  class="sticky top-0 z-40 border-b border-wool-200/70 bg-wool-50/85 backdrop-blur dark:border-wool-800/70 dark:bg-wool-950/85"
>
  <nav aria-label="Primary" class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3">
    <a href="#top" class="text-base font-bold tracking-tight">{profile.name}</a>
    <ul class="flex gap-1 text-sm font-medium sm:gap-2">
      {
        links.map((link) => (
          <li class={link.desktopOnly ? "hidden md:block" : undefined}>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center px-3 text-wool-700 hover:bg-wool-100 hover:text-wool-950 focus-visible:outline-2 focus-visible:outline-bark-600 dark:text-wool-300 dark:hover:bg-wool-800 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
