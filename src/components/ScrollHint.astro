---
// Once per visit, gently scrolls the page a little towards the works and back (see the script for when).
---

<script>
  // Nudges the page towards the works below: scrolls down a little and back. Runs once per visit to the page,
  // after the lights have been switched HINT_AFTER_TOGGLES times, or after IDLE_MS without a pull.
  const HINT_AFTER_TOGGLES = 3;
  const IDLE_MS = 5000;
  const html = document.documentElement;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  let done = false;
  let toggles = 0;
  let idle = 0;
  let wasDark = html.classList.contains("dark");

  const finish = () => {
    done = true;
    clearTimeout(idle);
    observer.disconnect();
  };
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
  const scrollTo = (top: number) => window.scrollTo({ top, behavior: "instant" });

  const hint = () => {
    if (done) return;
    finish();
    if (reduceMotion.matches || window.scrollY > 40) return;
    const depth = Math.min(180, innerHeight * 0.22);
    const legs = [
      { from: 0, to: depth, ms: 700 },
      { from: depth, to: depth, ms: 220 },
      { from: depth, to: 0, ms: 750 },
    ];
    // Any touch, wheel or key hands control back to the visitor straight away.
    let stopped = false;
    const stop = () => (stopped = true);
    const events = ["wheel", "touchstart", "pointerdown", "keydown"] as const;
    events.forEach((e) => addEventListener(e, stop, { once: true, passive: true }));
    let leg = 0;
    let start = performance.now();
    const step = (now: number) => {
      if (stopped) return;
      const { from, to, ms } = legs[leg];
      const t = Math.min(1, (now - start) / ms);
      scrollTo(from + (to - from) * ease(t));
      if (t === 1) {
        leg += 1;
        start = now;
        if (leg === legs.length) return events.forEach((e) => removeEventListener(e, stop));
      }
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const waitIdle = () => {
    clearTimeout(idle);
    idle = window.setTimeout(hint, IDLE_MS);
  };

  // The pull cord switches the theme by toggling the "dark" class, so watch for that.
  const observer = new MutationObserver(() => {
    const dark = html.classList.contains("dark");
    if (dark === wasDark) return;
    wasDark = dark;
    toggles += 1;
    if (toggles >= HINT_AFTER_TOGGLES) {
      clearTimeout(idle);
      // Let the lamps finish switching first.
      idle = window.setTimeout(hint, 1200);
    } else waitIdle();
  });
  observer.observe(html, { attributes: true, attributeFilter: ["class"] });

  // Someone who already scrolls on their own doesn't need the hint.
  addEventListener("scroll", () => window.scrollY > 40 && finish(), { passive: true });
  waitIdle();
</script>
