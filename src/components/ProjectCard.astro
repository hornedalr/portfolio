---
import { Image } from "astro:assets";
import type { Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const headingId = `project-${project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
// Landscape pictures span both columns; portraits (e.g. 4:5) sit side by side.
const wide = project.image.width > project.image.height;
const width = wide ? 1000 : 500;
const height = Math.round((width * project.image.height) / project.image.width);
---

<article aria-labelledby={headingId} class:list={[wide && "md:col-span-2"]}>
  <Image
    src={project.image}
    alt={project.alt}
    width={width}
    height={height}
    widths={wide ? [600, 1000, 2000] : [400, 500, 1000]}
    sizes={wide ? "(min-width: 1024px) 984px, 100vw" : "(min-width: 1024px) 480px, (min-width: 768px) 50vw, 100vw"}
    loading="lazy"
    decoding="async"
    class="h-auto w-full"
  />
  <div class="mt-3 grid grid-cols-[2fr_3fr] gap-4">
    <div>
      <h3 id={headingId} class="text-sm font-semibold tracking-wide uppercase">
      {
        project.href ? (
          <a href={project.href} class="hover:underline focus-visible:outline-2 focus-visible:outline-bark-600">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
      </h3>
      <dl class="mt-1.5 space-y-0.5 text-xs text-wool-600 dark:text-wool-400">
        {
          project.details.map((d) => (
            <div>
              <dt class="sr-only">{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="text-sm text-wool-600 dark:text-wool-400">{project.summary}</p>
  </div>
</article>