---
// Lamp-pull cord that toggles light/dark mode. Static SVG renders the resting cord; the script adds physics.
// Settings live in src/data/cord-settings.json; tune them live at /playground during `npm run dev`.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cordSettings as s } from "../scripts/cord-settings";

// Drop src/assets/cord-ball.png (and cord-ball-dark.png for dark mode) to replace the drawn ball.
// The cord attaches at the top centre of the image.
const ballImages = import.meta.glob<{ default: ImageMetadata }>("../assets/cord-ball{,-dark}.png", { eager: true });
const loadBall = async (name: string) => {
  const src = ballImages[`../assets/${name}.png`]?.default;
  if (!src) return undefined;
  const img = await getImage({ src, width: 128, format: "webp" });
  const w = 34;
  return { href: img.src, w, h: (w * src.height) / src.width };
};
const ballLight = await loadBall("cord-ball");
const ballDark = (await loadBall("cord-ball-dark")) ?? ballLight;

// Placeholder sheep, sketched facing right in a 360x300 space and mirrored to face into the page.
// The middle of its back (199.5, 19) is where the cord attaches.
const sheepScale = 34 / 297;
const sheepTransform = `translate(0 -11) scale(${-sheepScale} ${sheepScale}) translate(-199.5 -19)`;
const puffs = [[180, 70, 46], [128, 86, 42], [232, 86, 42], [96, 130, 40], [262, 128, 38], [140, 148, 46], [208, 150, 46], [176, 112, 52]];
// sign: +1 front legs (knees bend back), -1 hind legs (hocks bend forward).
const legs = [
  { x: 120, y: 180, sign: -1, delay: "[animation-delay:-0.4s]" },
  { x: 154, y: 186, sign: -1, delay: "[animation-delay:-2.1s]" },
  { x: 208, y: 186, sign: 1, delay: "[animation-delay:-1.3s]" },
  { x: 242, y: 180, sign: 1, delay: "[animation-delay:-2.9s]" },
];

interface Props {
  /** Positioning classes; defaults to hanging from the top-right of the hero. */
  class?: string;
  /** Enables live tuning events for the dev playground. */
  debug?: boolean;
}

const { class: position = "top-0 right-2 sm:right-6 xl:right-[calc((100vw-64rem)/2-5rem)]", debug = false } = Astro.props;

const width = 96;
const cx = width / 2;
const ballY = s.restLength + s.ballRadius - 2;
const ballScale = s.ballRadius / 13;
---

<div
  data-pull-cord
  data-debug={debug ? "" : undefined}
  class:list={["pointer-events-none absolute z-30 h-80 w-24 in-[.cord-intro]:invisible", position]}
>
  <svg
    class="absolute inset-0 h-full w-full overflow-visible"
    viewBox={`0 0 ${width} 320`}
    aria-hidden="true"
    focusable="false"
  >
    <path
      data-cord
      d={`M${cx} 0 L${cx} ${s.restLength}`}
      fill="none"
      stroke-width={s.cordWidth}
      stroke-linecap="round"
      class="stroke-wool-600 transition-[stroke] duration-150 dark:stroke-wool-400"
    ></path>
    <g data-ball transform={`translate(${cx} ${ballY}) scale(${ballScale})`}>
      {
        ballLight && ballDark ? (
          <>
            <image href={ballLight.href} x={-ballLight.w / 2} y="-11" width={ballLight.w} height={ballLight.h} class="dark:hidden" />
            <image href={ballDark.href} x={-ballDark.w / 2} y="-11" width={ballDark.w} height={ballDark.h} class="hidden dark:inline" />
          </>
        ) : (
          <g data-sheep class="group/sheep" transform={sheepTransform}>
            {legs.map((leg) => (
              <g data-leg data-x={leg.x} data-y={leg.y} data-sign={leg.sign} transform={`translate(${leg.x} ${leg.y})`}>
                <g class:list={["motion-safe:animate-[leg-sway_3.6s_ease-in-out_infinite]", leg.delay]}>
                  <rect x="-8" y="-10" width="16" height="42" rx="8" class="fill-wool-800" />
                  <g data-knee transform="translate(0 30)">
                    <g class:list={[leg.sign > 0 ? "motion-safe:animate-[knee-front_3.6s_ease-in-out_infinite]" : "motion-safe:animate-[knee-hind_3.6s_ease-in-out_infinite]", leg.delay]}>
                      <rect x="-7" y="-6" width="14" height="38" rx="7" class="fill-wool-800" />
                    </g>
                  </g>
                </g>
              </g>
            ))}
            <g class="fill-wool-50 stroke-wool-600" stroke-width="10">
              {puffs.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
            </g>
            <g class="fill-wool-50">
              {puffs.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
            </g>
            <g transform="translate(262 136)">
              <g class="transition-[rotate] duration-300 ease-out motion-safe:group-data-[baa]/sheep:-rotate-20">
                <g transform="translate(30 -4) rotate(14)">
                  <g class="fill-wool-800">
                    <ellipse cx="-30" cy="-26" rx="22" ry="10" transform="rotate(-30 -30 -26)" />
                    <ellipse cx="34" cy="-22" rx="22" ry="10" transform="rotate(30 34 -22)" />
                    <ellipse cx="2" cy="10" rx="36" ry="46" />
                  </g>
                  <g class="fill-wool-50">
                    <circle cx="-12" cy="0" r="6" />
                    <circle cx="16" cy="0" r="6" />
                  </g>
                  <ellipse cx="2" cy="38" rx="9" ry="7" class="fill-bark-300 opacity-0 transition-opacity duration-200 group-data-[baa]/sheep:opacity-100" />
                  <circle cx="0" cy="-42" r="18" class="fill-wool-50 stroke-wool-600" stroke-width="5" />
                </g>
              </g>
            </g>
          </g>
        )
      }
    </g>
  </svg>
  <div
    data-baa
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-0 z-10 origin-bottom-right -translate-x-full -translate-y-full scale-50 opacity-0 transition-[scale,opacity] duration-300 ease-out data-[show]:scale-100 data-[show]:opacity-100"
  >
    <div
      class="relative rounded-full border border-wool-300 bg-wool-50 px-5 pt-1 pb-2 font-script text-3xl leading-none whitespace-nowrap text-wool-900 shadow-sm dark:border-wool-700 dark:bg-wool-900 dark:text-wool-100"
    >
      bääääh
      <span class="absolute -right-1 -bottom-2.5 size-3 rounded-full border border-wool-300 bg-wool-50 dark:border-wool-700 dark:bg-wool-900"></span>
      <span class="absolute -right-3 -bottom-5 size-1.5 rounded-full border border-wool-300 bg-wool-50 dark:border-wool-700 dark:bg-wool-900"></span>
    </div>
  </div>
  <button
    type="button"
    data-cord-handle
    aria-pressed="false"
    aria-label="Dark mode"
    title="Pull for dark mode"
    class="pointer-events-auto absolute top-0 left-0 size-11 cursor-grab touch-none select-none before:absolute before:inset-[calc(var(--grab,0px)*-1)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bark-600 active:cursor-grabbing"
    style={`transform: translate(${cx - 22}px, ${ballY - 22}px)`}
  >
  </button>
</div>

<script>
  import { Rope } from "../scripts/rope";
  import { cordSettings, type CordSettings } from "../scripts/cord-settings";

  const TAP_SLOP = 6;
  const STEP_MS = 1000 / 60;

  const root = document.querySelector<HTMLElement>("[data-pull-cord]");
  const cord = root?.querySelector<SVGPathElement>("[data-cord]");
  const ballEl = root?.querySelector<SVGGElement>("[data-ball]");
  const handle = root?.querySelector<HTMLButtonElement>("[data-cord-handle]");

  if (root && cord && ballEl && handle) {
    const html = document.documentElement;
    const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const debug = root.hasAttribute("data-debug");
    const anchorX = root.clientWidth / 2;

    let s: CordSettings = { ...cordSettings };
    let timeScale = 1;
    const buildRope = () => new Rope({ anchorX, anchorY: 0, ...s });
    let rope = buildRope();

    const isDark = () => html.classList.contains("dark");

    // Android supports the Vibration API. iOS Safari doesn't, but toggling a native switch control gives a haptic
    // tick (iOS 18+), so a hidden one is toggled instead.
    const haptic = () => {
      if (typeof navigator.vibrate === "function") {
        navigator.vibrate(10);
        return;
      }
      const label = document.createElement("label");
      label.ariaHidden = "true";
      label.style.display = "none";
      const input = document.createElement("input");
      input.type = "checkbox";
      input.setAttribute("switch", "");
      label.append(input);
      document.head.append(label);
      label.click();
      label.remove();
    };

    const syncLabel = () => {
      const dark = isDark();
      handle.setAttribute("aria-pressed", String(dark));
      handle.title = dark ? "Pull for light mode" : "Pull for dark mode";
    };

    const toggleTheme = () => {
      const dark = !isDark();
      if (!reduceMotion.matches) {
        html.classList.add("theme-fade");
        window.setTimeout(() => html.classList.remove("theme-fade"), 450);
      }
      html.classList.toggle("dark", dark);
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {
        // Storage can be unavailable (private mode); the toggle still works for this visit.
      }
      themeMeta?.setAttribute("content", dark ? "#171514" : "#faf8f4");
      syncLabel();
    };

    let armed = false;
    let grabSize = 0;
    let dirX = 0;
    let dirY = 1;
    let ballX = rope.handleX;
    let ballY = rope.handleY;
    let ballAngle = 0;

    // Sheep legs: damped springs at hips and knees, driven by the sheep's acceleration so they lag behind its
    // motion. Knees only bend one way and stop hard at their joint limits.
    const KNEE_MAX = 30;
    const KNEE_REST = 4;
    const legs = [...ballEl.querySelectorAll<SVGGElement>("[data-leg]")].map((el) => ({
      el,
      knee: el.querySelector<SVGGElement>("[data-knee]")!,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      sign: Number(el.dataset.sign),
      hip: 0,
      hipV: 0,
      bend: KNEE_REST,
      bendV: 0,
    }));
    let prevX = rope.handleX;
    let prevY = rope.handleY;
    let prevVX = 0;
    let prevVY = 0;
    const stepLegs = () => {
      const vx = rope.handleX - prevX;
      const vy = rope.handleY - prevY;
      const ax = vx - prevVX;
      const ay = vy - prevVY;
      prevX = rope.handleX;
      prevY = rope.handleY;
      prevVX = vx;
      prevVY = vy;
      // Into the sheep's own frame: undo its tilt, then its left-right mirroring.
      const a = (ballAngle * Math.PI) / 180;
      const side = Math.max(-3, Math.min(3, -(ax * Math.cos(a) + ay * Math.sin(a))));
      for (const leg of legs) {
        const hipTarget = Math.max(-12, Math.min(12, ballAngle * 0.25 + side * 6));
        leg.hipV = (leg.hipV + (hipTarget - leg.hip) * 0.07) * 0.86;
        leg.hip = Math.max(-16, Math.min(16, leg.hip + leg.hipV));
        const bendTarget = KNEE_REST + leg.sign * (side * 10 - leg.hipV * 0.6);
        leg.bendV = (leg.bendV + (bendTarget - leg.bend) * 0.1) * 0.85;
        leg.bend += leg.bendV;
        if (leg.bend < 0 || leg.bend > KNEE_MAX) {
          leg.bend = Math.max(0, Math.min(KNEE_MAX, leg.bend));
          leg.bendV = 0;
        }
      }
    };
    const legsMoving = () => legs.some((l) => Math.abs(l.hipV) > 0.02 || Math.abs(l.bendV) > 0.02 || Math.abs(l.hip) > 0.3);
    const resetLegs = () => {
      prevX = rope.handleX;
      prevY = rope.handleY;
      prevVX = prevVY = 0;
      for (const leg of legs) {
        leg.hip = leg.hipV = leg.bendV = 0;
        leg.bend = KNEE_REST;
      }
    };
    const renderLegs = () => {
      for (const leg of legs) {
        leg.el.setAttribute("transform", `translate(${leg.x} ${leg.y}) rotate(${leg.hip.toFixed(2)})`);
        leg.knee.setAttribute("transform", `translate(0 30) rotate(${(leg.sign * leg.bend).toFixed(2)})`);
      }
    };

    // The sheep lifts its head and baas; a thought bubble floats next to its head for 2s.
    const sheep = ballEl.querySelector<SVGGElement>("[data-sheep]");
    const bubble = root.querySelector<HTMLElement>("[data-baa]");
    const placeBubble = () => {
      if (!bubble) return;
      // The head sits about 10.6 units ahead of and 2 units below the cord attach in the sheep's frame.
      const a = (ballAngle * Math.PI) / 180;
      const k = s.ballRadius / 13;
      const lx = -10.6 * k;
      const ly = 1.9 * k;
      const headX = ballX + lx * Math.cos(a) - ly * Math.sin(a);
      const headY = ballY + lx * Math.sin(a) + ly * Math.cos(a);
      bubble.style.left = `${(headX - 16).toFixed(1)}px`;
      bubble.style.top = `${(headY - 30).toFixed(1)}px`;
    };
    let baaHide = 0;
    const baa = () => {
      sheep?.toggleAttribute("data-baa", true);
      placeBubble();
      bubble?.toggleAttribute("data-show", true);
      clearTimeout(baaHide);
      baaHide = window.setTimeout(() => {
        sheep?.removeAttribute("data-baa");
        bubble?.removeAttribute("data-show");
      }, 2000);
    };
    // First baa 4.4s after the intro swing begins (the intro starts as soon as this script runs, on every load).
    const FIRST_BAA_MS = 4_400;
    window.setTimeout(baa, FIRST_BAA_MS);

    // Every 5th pull in a row the sheep baas, 2s after that pull. A pause longer than STREAK_GAP_MS starts a new row.
    const PULLS_PER_BAA = 5;
    const STREAK_GAP_MS = 4000;
    let pulls = 0;
    let lastPull = 0;
    const countPull = () => {
      const now = performance.now();
      if (now - lastPull > STREAK_GAP_MS) pulls = 0;
      lastPull = now;
      pulls += 1;
      if (pulls === PULLS_PER_BAA) {
        pulls = 0;
        window.setTimeout(baa, 2000);
      }
    };

    const render = () => {
      cord.setAttribute("d", rope.toPath());
      // The ball hangs off the cord end along the last segment, so it pivots around its attach point.
      const n = rope.n;
      const sx = rope.xs[n - 1] - rope.xs[n - 2];
      const sy = rope.ys[n - 1] - rope.ys[n - 2];
      const sl = Math.hypot(sx, sy);
      if (sl > 0.5) {
        dirX = sx / sl;
        dirY = sy / sl;
      }
      const reach = s.ballRadius - 2;
      const hx = rope.handleX + dirX * reach;
      const hy = rope.handleY + dirY * reach;
      const angle = (Math.atan2(dirX, dirY) * -180) / Math.PI;
      ballX = hx;
      ballY = hy;
      ballAngle = angle;
      ballEl.setAttribute(
        "transform",
        `translate(${hx.toFixed(1)} ${hy.toFixed(1)}) rotate(${angle.toFixed(1)}) scale(${(s.ballRadius / 13).toFixed(3)})`,
      );
      handle.style.transform = `translate(${(hx - 22).toFixed(1)}px, ${(hy - 22).toFixed(1)}px)`;
      renderLegs();
      if (bubble?.hasAttribute("data-show")) placeBubble();

      // A moving ball is hard to catch, so widen the invisible hit area until it settles.
      const grab = rope.isDragging || rope.energy > 0.05 ? s.swingGrab : 0;
      if (grab !== grabSize) {
        grabSize = grab;
        handle.style.setProperty("--grab", `${grab}px`);
      }

      const tension = Math.min(rope.stretch / Math.max(s.maxStretch, 1), 1);
      cord.setAttribute("stroke-width", Math.max(s.cordWidth - tension * s.tensionThinning, 0.5).toFixed(2));
      const nowArmed = rope.isDragging && rope.stretch >= s.trigger;
      if (nowArmed !== armed) {
        armed = nowArmed;
        cord.classList.toggle("stroke-bark-600!", armed);
        cord.classList.toggle("dark:stroke-bark-300!", armed);
        if (armed) haptic();
      }
      if (debug) {
        root.dispatchEvent(
          new CustomEvent("cord:frame", {
            bubbles: true,
            detail: {
              offset: rope.handleY - s.restLength,
              stretch: rope.stretch,
              armed,
              dragging: rope.isDragging,
              energy: rope.energy,
            },
          }),
        );
      }
    };

    // Fixed 60 Hz simulation; the loop sleeps whenever the cord is at rest.
    let raf = 0;
    let last = 0;
    let acc = 0;
    let autoPull: ((now: number) => void) | null = null;
    let introHold = 0;
    const frame = (now: number) => {
      // Keep the intro start pose still until its delay has passed, even if something else woke the loop.
      if (introHold) {
        last = now;
        acc = STEP_MS;
        raf = requestAnimationFrame(frame);
        return;
      }
      acc += Math.min(now - last, 100) * timeScale;
      last = now;
      autoPull?.(now);
      while (acc >= STEP_MS) {
        rope.step();
        stepLegs();
        acc -= STEP_MS;
      }
      render();
      if (rope.isDragging || autoPull || rope.energy > 0.002 || legsMoving()) {
        raf = requestAnimationFrame(frame);
      } else {
        raf = 0;
        rope.reset();
        resetLegs();
        render();
      }
    };
    const wake = () => {
      if (raf) return;
      last = performance.now();
      // Always run at least one step, so a rope posed at zero velocity isn't mistaken for settled.
      acc = STEP_MS;
      raf = requestAnimationFrame(frame);
    };

    /** Ends a drag, toggling the theme if the cord was pulled far enough. */
    const finishPull = (wasDrag: boolean) => {
      const pulledEnough = rope.stretch >= s.trigger;
      rope.endDrag();
      if (wasDrag && pulledEnough) {
        toggleTheme();
        countPull();
      }
      if (reduceMotion.matches) rope.reset();
      render();
      wake();
    };

    let pointerId: number | null = null;
    let grabDx = 0;
    let grabDy = 0;
    let startX = 0;
    let startY = 0;
    let moved = false;
    let suppressClick = false;

    const local = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };

    handle.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || pointerId !== null) return;
      cancelPullHint();
      if (autoPull) return;
      clearTimeout(introHold);
      introHold = 0;
      pointerId = e.pointerId;
      handle.setPointerCapture(e.pointerId);
      const p = local(e);
      grabDx = p.x - rope.handleX;
      grabDy = p.y - rope.handleY;
      startX = e.clientX;
      startY = e.clientY;
      moved = false;
      rope.startDrag(p.x - grabDx, p.y - grabDy);
      wake();
    });

    handle.addEventListener("pointermove", (e) => {
      if (e.pointerId !== pointerId) return;
      if (!moved && Math.hypot(e.clientX - startX, e.clientY - startY) > TAP_SLOP) moved = true;
      const p = local(e);
      rope.setDragTarget(p.x - grabDx, p.y - grabDy);
    });

    const release = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      // A plain tap is handled by the click listener; a drag decides here and swallows the click.
      if (moved) suppressClick = true;
      finishPull(moved);
    };
    handle.addEventListener("pointerup", release);
    handle.addEventListener("pointercancel", (e) => {
      if (e.pointerId !== pointerId) return;
      moved = false;
      release(e);
    });

    // Taps and keyboard (Enter/Space) give the cord a tug and toggle.
    handle.addEventListener("click", () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      cancelPullHint();
      if (!reduceMotion.matches) {
        rope.tug(s.tapTug);
        wake();
      }
      toggleTheme();
      countPull();
    });

    handle.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "mouse" && pointerId === null && !reduceMotion.matches) {
        rope.impulse(s.hoverNudge, 0);
        wake();
      }
    });

    // Follow OS theme changes until the visitor has made an explicit choice.
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem("theme");
      } catch {
        stored = null;
      }
      if (stored === null && e.matches !== isDark()) {
        html.classList.toggle("dark", e.matches);
        syncLabel();
      }
    });

    /** Page-load swing: start the cord raised to the side, then let it fall in. */
    const playIntro = () => {
      if (reduceMotion.matches || !s.introAngle || rope.isDragging || autoPull) {
        html.classList.remove("cord-intro");
        return;
      }
      rope.pose(s.introAngle, s.introStretch);
      render();
      html.classList.remove("cord-intro");
      clearTimeout(introHold);
      introHold = window.setTimeout(() => {
        introHold = 0;
        wake();
      }, s.introDelay / timeScale);
    };

    if (debug) {
      window.addEventListener("cord:intro", playIntro);
      // Make the otherwise invisible grab area visible while tuning.
      handle.classList.add("before:outline-1", "before:outline-dashed", "before:outline-bark-500");
      window.addEventListener("cord:tune", (e) => {
        const { settings, timeScale: ts } = (e as CustomEvent<{ settings: CordSettings; timeScale: number }>).detail;
        const rebuild = settings.restLength !== s.restLength || settings.points !== s.points;
        s = { ...settings };
        timeScale = ts;
        if (rebuild && !rope.isDragging) rope = buildRope();
        else rope.configure(s);
        render();
        wake();
      });

      // Scripted pull to an exact stretch, for repeatable comparisons while tuning.
      window.addEventListener("cord:autopull", (e) => {
        if (pointerId !== null || autoPull) return;
        const { distance, sideways = 0 } = (e as CustomEvent<{ distance: number; sideways?: number }>).detail;
        const ratio = Math.min(distance / Math.max(s.maxStretch, 1), 0.995);
        const raw = s.restLength + s.maxStretch * Math.atanh(ratio);
        const pullMs = 280 / timeScale;
        const holdMs = 160 / timeScale;
        let t0 = -1;
        autoPull = (now) => {
          if (t0 < 0) {
            t0 = now;
            rope.startDrag(anchorX, s.restLength);
          }
          const k = Math.min((now - t0) / pullMs, 1);
          const ease = 1 - (1 - k) ** 3;
          rope.setDragTarget(anchorX + sideways * ease, s.restLength + (raw - s.restLength) * ease);
          if (now - t0 >= pullMs + holdMs) {
            autoPull = null;
            finishPull(true);
          }
        };
        wake();
      });
    }

    // If the cord hasn't been touched 3s after the first baa, it gives itself one short tug (not far enough to
    // switch the lights) to show that it can be pulled.
    const PULL_HINT_MS = FIRST_BAA_MS + 3000;
    let pullHint: ((now: number) => void) | null = null;
    let touched = false;
    const cancelPullHint = () => {
      touched = true;
      if (!pullHint || autoPull !== pullHint) return;
      autoPull = pullHint = null;
      rope.endDrag();
    };
    window.setTimeout(() => {
      if (touched || reduceMotion.matches || pointerId !== null || autoPull || rope.isDragging) return;
      if (document.hidden || window.scrollY > innerHeight / 2) return;
      const fromX = rope.handleX;
      const fromY = rope.handleY;
      const depth = s.trigger * 0.45;
      const downMs = 420;
      let t0 = -1;
      pullHint = autoPull = (now) => {
        if (t0 < 0) {
          t0 = now;
          rope.startDrag(fromX, fromY);
        }
        const k = Math.min((now - t0) / downMs, 1);
        const ease = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
        rope.setDragTarget(fromX, fromY + depth * ease);
        if (k === 1) {
          autoPull = pullHint = null;
          finishPull(false);
        }
      };
      wake();
    }, PULL_HINT_MS);

    syncLabel();
    playIntro();
  }
</script>
