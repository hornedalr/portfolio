---
import { Image } from "astro:assets";
import { slug, type Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const headingId = `project-${slug(project.title)}`;
// Landscape pictures span both columns; portraits (e.g. 4:5) sit side by side.
const wide = project.image.width > project.image.height;
const width = wide ? 1500 : 750;
const height = Math.round((width * project.image.height) / project.image.width);
const slides = [{ image: project.image, alt: project.alt }, ...(project.gallery ?? [])];
const multiple = slides.length > 1;
const arrow =
  "absolute top-1/2 hidden size-10 -translate-y-1/2 items-center justify-center text-white opacity-0 drop-shadow-[0_0_3px_rgb(0_0_0/0.55)] transition-opacity duration-200 group-hover/gallery:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-bark-600 disabled:pointer-events-none disabled:invisible pointer-fine:flex";
---

<article id={`work-${slug(project.title)}`} aria-labelledby={headingId} class:list={["reveal scroll-mt-24", wide && "md:col-span-2"]}>
  <div data-gallery={multiple ? "" : undefined} class="group/gallery relative">
    <div
      data-gallery-track
      role={multiple ? "region" : undefined}
      aria-roledescription={multiple ? "carousel" : undefined}
      aria-label={multiple ? `${project.title}, ${slides.length} pictures` : undefined}
      tabindex={multiple ? 0 : undefined}
      class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bark-600 [&::-webkit-scrollbar]:hidden"
    >
      {
        slides.map((slide, i) => (
          <div
            role={multiple ? "group" : undefined}
            aria-roledescription={multiple ? "slide" : undefined}
            aria-label={multiple ? `${i + 1} of ${slides.length}` : undefined}
            class="w-full flex-none snap-center snap-always"
          >
            <Image
              src={slide.image}
              alt={slide.alt}
              width={width}
              height={height}
              widths={wide ? [800, 1200, 1600] : [400, 750, 1080]}
              sizes={wide ? "(min-width: 1696px) 1504px, 100vw" : "(min-width: 1696px) 728px, (min-width: 768px) 50vw, 100vw"}
              loading="lazy"
              decoding="async"
              class="h-auto w-full object-cover"
            />
          </div>
        ))
      }
    </div>
    {
      multiple && (
        <>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center gap-1.5 opacity-0 transition-opacity duration-300 group-hover/gallery:opacity-100 group-data-[swiping]/gallery:opacity-100"
          >
            {slides.map((_, i) => (
              <span
                data-dot
                data-active={i === 0 ? "" : undefined}
                class="size-1.5 rounded-full bg-white/50 shadow-[0_0_2px_rgb(0_0_0/0.4)] transition-[background-color,scale] duration-300 data-[active]:scale-125 data-[active]:bg-white"
              />
            ))}
          </div>
          <button type="button" data-gallery-prev disabled aria-label="Previous picture" class:list={[arrow, "left-3"]}>
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button type="button" data-gallery-next aria-label="Next picture" class:list={[arrow, "right-3"]}>
            <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </>
      )
    }
  </div>
  <div class="mt-3 grid grid-cols-[2fr_3fr] gap-4">
    <div>
      <h3 id={headingId} class="text-sm font-semibold tracking-wide uppercase">
      {
        project.href ? (
          <a href={project.href} class="hover:underline focus-visible:outline-2 focus-visible:outline-bark-600">
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
      </h3>
      <dl class="mt-1.5 space-y-0.5 text-xs text-wool-600 dark:text-wool-400">
        {
          project.details.map((d) => (
            <div>
              <dt class="sr-only">{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="text-sm text-wool-600 dark:text-wool-400">{project.summary}</p>
  </div>
</article>

<script>
  // Swiping itself is native scroll snapping; this only lights the dot for the current picture, shows the dots while
  // swiping, and drives the desktop arrow buttons.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const track = gallery.querySelector<HTMLElement>("[data-gallery-track]")!;
    const dots = [...gallery.querySelectorAll<HTMLElement>("[data-dot]")];
    const prev = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]")!;
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]")!;
    let current = 0;
    // Picture an arrow click is heading to while its smooth scroll runs, so quick repeated clicks keep stepping.
    let target = -1;
    let hideDots = 0;
    let settle = 0;

    const update = () => {
      const i = Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
      if (i === current) return;
      current = i;
      dots.forEach((dot, k) => dot.toggleAttribute("data-active", k === i));
      prev.disabled = i === 0;
      next.disabled = i === dots.length - 1;
    };

    track.addEventListener(
      "scroll",
      () => {
        gallery.toggleAttribute("data-swiping", true);
        update();
        clearTimeout(hideDots);
        hideDots = window.setTimeout(() => gallery.removeAttribute("data-swiping"), 1500);
        clearTimeout(settle);
        settle = window.setTimeout(() => (target = -1), 150);
      },
      { passive: true },
    );

    const go = (step: number) => {
      target = Math.max(0, Math.min(dots.length - 1, (target < 0 ? current : target) + step));
      track.scrollTo({ left: target * track.clientWidth, behavior: reduceMotion.matches ? "instant" : "smooth" });
    };
    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
  }
</script>