---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Shop from "../components/Shop.astro";
import Cart from "../components/Cart.astro";
import Search from "../components/Search.astro";
import Exhibitions from "../components/Exhibitions.astro";
import { Image } from "astro:assets";
import { profile, projects } from "../data/site";

const year = new Date().getFullYear();
---

<BaseLayout title={`${profile.name} — ${profile.role}`} description={profile.tagline}>
  <Header />
  <Cart />
  <Search />
  <main id="main">
    <Hero />

    <section id="work" aria-labelledby="work-heading" class="scroll-mt-16 bg-wool-100 py-16 sm:py-24 dark:bg-wool-900/50">
      <div class="mx-auto max-w-[100rem] px-5 lg:px-12">
        <h2 id="work-heading" class="text-3xl font-bold tracking-wide uppercase">Selected works</h2>
        <p class="mt-2 text-wool-600 dark:text-wool-400">A few projects I've designed and built recently.</p>
        <div class="mt-10 grid gap-x-6 gap-y-12 md:grid-cols-2 lg:gap-x-12 lg:gap-y-20">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <Exhibitions />

    <Shop />

    <section id="about" aria-labelledby="about-heading" class="scroll-mt-16 py-16 sm:py-24">
      <div class="mx-auto max-w-xl px-5">
        <Image
          src={profile.portrait}
          alt={profile.portraitAlt}
          width={576}
          height={720}
          widths={[400, 576, 1080]}
          sizes="(min-width: 640px) 536px, 100vw"
          loading="lazy"
          decoding="async"
          class="reveal h-auto w-full"
        />
        <h2 id="about-heading" class="mt-8 text-3xl font-bold tracking-wide uppercase">About me</h2>
        {profile.bio.map((paragraph) => <p class="mt-4 text-lg text-wool-700 dark:text-wool-300">{paragraph}</p>)}
      </div>
    </section>

    <section id="contact" aria-labelledby="contact-heading" class="scroll-mt-16 bg-wool-200 py-16 text-wool-900 dark:bg-wool-900 dark:text-wool-100 sm:py-24">
      <div class="mx-auto max-w-5xl px-5 text-center">
        <h2 id="contact-heading" class="sr-only">Contact</h2>
        <p class="font-script text-5xl sm:text-6xl">{profile.name}</p>
        <ul class="mt-6 flex flex-col items-center gap-1">
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex min-h-11 items-center px-3 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-bark-600"
            >
              {profile.email}
            </a>
          </li>
          <li>
            <a
              href={profile.instagram.href}
              rel="me noopener"
              class="inline-flex min-h-11 items-center gap-2 px-3 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-bark-600"
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.6" class="fill-current" />
              </svg>
              <span>@{profile.instagram.handle}<span class="sr-only"> on Instagram</span></span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="py-8 text-center text-sm text-wool-600 dark:text-wool-400">
    <p>&copy; {year} {profile.name}. Built with Astro &amp; Tailwind CSS.</p>
  </footer>
</BaseLayout>
