---
import { Image } from "astro:assets";
import hero from "../assets/hero.png";
import { profile } from "../data/site";
---

<section id="top" aria-labelledby="hero-heading" class="mx-auto max-w-5xl px-5 pt-12 pb-16 sm:pt-20 sm:pb-24">
  <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="text-sm font-semibold tracking-wide text-teal-700 uppercase dark:text-teal-400">{profile.role}</p>
      <h1 id="hero-heading" class="mt-3 text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Hi, I'm {profile.name}. {profile.tagline}
      </h1>
      <p class="mt-5 max-w-prose text-lg text-slate-600 dark:text-slate-400">
        Based in {profile.location}. Currently open to freelance and full-time roles.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#work"
          class="inline-flex min-h-11 items-center rounded-lg bg-teal-700 px-5 font-semibold text-white hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600"
        >
          View my work
        </a>
        <a
          href="#contact"
          class="inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-5 font-semibold hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 dark:border-slate-700 dark:hover:bg-slate-800"
        >
          Get in touch
        </a>
      </div>
    </div>
    <Image
      src={hero}
      alt={`Illustrated portrait of ${profile.name}`}
      width={480}
      height={480}
      widths={[320, 480, 960]}
      sizes="(min-width: 768px) 480px, 80vw"
      loading="eager"
      fetchpriority="high"
      class="mx-auto aspect-square w-4/5 max-w-sm rounded-3xl shadow-xl md:w-full"
    />
  </div>
</section>
