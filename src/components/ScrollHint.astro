---
// Once per visit, after a few pulls of the cord, gently scrolls the page a little towards the works and back.
---

<script>
  // Nudges the page towards the works below: eases down until the works heading peeks in, then back up. Plays once
  // per page load, only after the lights have been switched HINT_AFTER_TOGGLES times.
  const HINT_AFTER_TOGGLES = 3;
  // Down, a short look at the works heading, back up.
  const DOWN_MS = 1100;
  const HOLD_MS = 450;
  const UP_MS = 1200;
  const html = document.documentElement;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  let done = false;
  let toggles = 0;
  let wait = 0;
  let wasDark = html.classList.contains("dark");

  const finish = () => {
    done = true;
    clearTimeout(wait);
    observer.disconnect();
  };
  // Sine ease in and out: starts and stops without a jolt.
  const ease = (t: number) => (1 - Math.cos(Math.PI * t)) / 2;
  const scrollTo = (top: number) => window.scrollTo({ top, behavior: "instant" });

  const hint = () => {
    if (done) return;
    finish();
    if (reduceMotion.matches || window.scrollY > 40) return;
    // Far enough that the "Selected works" heading comes into view, so it's clear there's more below.
    const heading = document.querySelector("#work-heading");
    const reveal = heading ? heading.getBoundingClientRect().bottom - innerHeight + 24 : 0;
    const depth = Math.max(80, Math.min(reveal, innerHeight * 0.4));
    // Any touch, wheel or key hands control back to the visitor straight away.
    let stopped = false;
    const stop = () => (stopped = true);
    const events = ["wheel", "touchstart", "pointerdown", "keydown"] as const;
    events.forEach((e) => addEventListener(e, stop, { once: true, passive: true }));
    const start = performance.now();
    const step = (now: number) => {
      if (stopped) return;
      const ms = now - start;
      const k = ms < DOWN_MS ? ease(ms / DOWN_MS) : ms < DOWN_MS + HOLD_MS ? 1 : ease(1 - Math.min(1, (ms - DOWN_MS - HOLD_MS) / UP_MS));
      scrollTo(depth * k);
      if (ms < DOWN_MS + HOLD_MS + UP_MS) requestAnimationFrame(step);
      else events.forEach((e) => removeEventListener(e, stop));
    };
    requestAnimationFrame(step);
  };

  // The pull cord switches the theme by toggling the "dark" class, so watch for that.
  const observer = new MutationObserver(() => {
    const dark = html.classList.contains("dark");
    if (dark === wasDark) return;
    wasDark = dark;
    toggles += 1;
    if (toggles < HINT_AFTER_TOGGLES) return;
    clearTimeout(wait);
    // Let the lamps finish switching first.
    wait = window.setTimeout(hint, 1200);
  });
  observer.observe(html, { attributes: true, attributeFilter: ["class"] });

  // Someone who already scrolls on their own doesn't need the hint.
  addEventListener("scroll", () => window.scrollY > 40 && finish(), { passive: true });
</script>