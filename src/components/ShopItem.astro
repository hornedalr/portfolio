---
import { Image } from "astro:assets";
import { formatPrice, productHref, type Product } from "../data/shop";
import AddToCart from "./AddToCart.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<li id={product.id} class="reveal flex scroll-mt-24 flex-col">
  <a href={productHref(product)} tabindex="-1" aria-hidden="true" class="block">
  <Image
    src={product.image}
    alt={product.alt}
    width={320}
    height={400}
    widths={[240, 320, 640]}
    sizes="(min-width: 1024px) 312px, 50vw"
    loading="lazy"
    decoding="async"
    class:list={["h-auto w-full", product.sold && "opacity-60"]}
  />
  </a>
  <h4 class="mt-3 text-sm font-semibold tracking-wide uppercase">
    <a href={productHref(product)} class="hover:underline focus-visible:outline-2 focus-visible:outline-bark-600">{product.title}</a>
  </h4>
  <p class="mt-0.5 text-xs text-wool-600 dark:text-wool-400">{product.detail}</p>
  <p class="mt-1 mb-3 text-sm tabular-nums">
    {product.sold ? <s class="text-wool-600 dark:text-wool-400">{formatPrice(product.price)}</s> : formatPrice(product.price)}
  </p>
  <AddToCart product={product} class="mt-auto" />
</li>